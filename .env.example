# Orchestrator
PORT=4000
DATA_DIR=./data
DB_FILE=./data/roleplay.sqlite

# SillyTavern
ST_BASE_URL=http://127.0.0.1:8000
ST_API_KEY=

# Default models (names as configured inside SillyTavern / Ollama)
LLM_DEFAULT_MODEL=hf.co/mradermacher/Ministral-Instruct-2410-8B-DPO-RP-GGUF:Q4_K_M
LLM_GM_MODEL=hf.co/mradermacher/Ministral-Instruct-2410-8B-DPO-RP-GGUF:Q4_K_M
LLM_UTILITY_MODEL=hf.co/mradermacher/Ministral-Instruct-2410-8B-DPO-RP-GGUF:Q4_K_M
# Vision-capable model (used for image inputs / character portraits captioning).
# rp-vision:4b is a local alias built from huihui_ai/qwen3-vl-abliterated:4b
# via models/rp-vision.Modelfile (pins num_ctx=8192 for full-GPU offload on 8 GB VRAM).
LLM_VISION_MODEL=rp-vision:4b

# Adapters
STT_PROVIDER=whisper-cpp
WHISPER_CPP_URL=http://127.0.0.1:8081/inference

TTS_PROVIDER=xtts
XTTS_URL=http://127.0.0.1:8020

IMAGE_PROVIDER=sdwebui
SDWEBUI_URL=http://127.0.0.1:7860
# Where the orchestrator looks when populating the LoRA picker in the Play UI.
LORA_DIR=./vendor/sd-webui-forge/models/Lora
# Auto-applied to every image generation. Override per-call only by editing
# the prompt yourself (the orchestrator does not de-dup these tags).
# Pony Realism's author recommends score tags + a quality LoRA stack.
IMAGE_DEFAULT_POSITIVE=score_9, score_8_up, score_7_up, BREAK
IMAGE_DEFAULT_NEGATIVE=score_4, score_5, score_6, (worst quality, low quality:1.3), bad anatomy, deformed, extra fingers, blurry
# Comma-separated `loraName:weight` pairs. Files must exist in
# vendor/sd-webui-forge/models/Lora/. Leave empty to disable.
IMAGE_DEFAULT_LORAS=pony_realism_enhancer:0.7,pony_skin_enhancer:0.6

# Web
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:4000
